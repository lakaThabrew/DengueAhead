{
  "name": "dengueahead-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace=@dengueahead/api",
    "dev:web": "npm run dev --workspace=@dengueahead/web",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test:unit": "npm run test:unit --workspaces"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}

